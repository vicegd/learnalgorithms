# Copy to .env on the server (chmod 600) and fill in. Never commit .env.
ALLOWED_ORIGIN=https://learnalgorithms.dev
MATOMO_URL=https://stats.garcia.at/
MATOMO_SITE_ID=7
# Matomo > Personal > Security > Auth tokens: a token of a user with view access only.
MATOMO_TOKEN=
# openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# openssl rand -hex 32
ADMIN_TOKEN=
TRUST_PROXY=1
# Optional host port override when 8080 is already taken on the VPS
API_HOST_PORT=8080
